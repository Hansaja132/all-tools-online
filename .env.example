# Database Configuration
DATABASE_URL="postgresql://tools_user:tools_password@localhost:5432/tools_db?schema=public"

# Backend API Configuration
PORT=5000
NODE_ENV="development"
# In production, set CLIENT_URL to your live frontend URL (e.g., https://your-domain.vercel.app)
CLIENT_URL="http://localhost:3000"

# Authentication Secrets (minimum 32 characters)
JWT_SECRET="super_secret_jwt_key_that_is_at_least_thirty_two_chars_long"
JWT_REFRESH_SECRET="super_secret_refresh_jwt_key_that_is_at_least_thirty_two_chars_long"

# JWT Expirations
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Email SMTP Settings (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="no-reply@multi-tools.com"

# Next.js Web Frontend Environment Variables
# In production (e.g., Vercel), ensure URLs include the protocol prefix (http:// or https://)
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For Vercel deployment:
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
# NEXT_PUBLIC_API_URL="https://your-api-domain.com/api/v1"

# ==============================================================================
# Monetization / Ads Configuration (Adsterra & Monetag)
# ==============================================================================
# Master toggle for all ads (set to false to disable all ad slots)
NEXT_PUBLIC_ENABLE_ADS=true
# Set to true to view visual slot markers in development
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=true

# Monetag Configuration
NEXT_PUBLIC_MONETAG_ENABLED=false
# Monetag MultiTag Zone ID (from Monetag Dashboard > Sites > Get MultiTag)
NEXT_PUBLIC_MONETAG_ZONE_ID=""
# Monetag In-Page Push (IPP) Zone ID
NEXT_PUBLIC_MONETAG_IPP_ZONE=""
# Monetag Banner Zones
NEXT_PUBLIC_MONETAG_LEADERBOARD=""
NEXT_PUBLIC_MONETAG_RECTANGLE=""

# Adsterra Configuration
NEXT_PUBLIC_ADSTERRA_ENABLED=false
# Adsterra Social Bar script URL (from Adsterra > Websites > Add Unit > Social Bar)
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_URL=""
# Adsterra Popunder script URL (use with 1/24h frequency capping for UX)
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=""
# Adsterra Direct Link / SmartLink URL
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK=""
# Adsterra Display Banner Keys (from Adsterra > Websites > Add Unit > Banners)
NEXT_PUBLIC_ADSTERRA_728x90_KEY=""
NEXT_PUBLIC_ADSTERRA_300x250_KEY=""
NEXT_PUBLIC_ADSTERRA_320x50_KEY=""
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=""

